# CNC 刀具管理系统 - 环境变量配置

# 数据库连接 (MySQL/MariaDB)
DATABASE_URL="mysql://cnc_user:cnc_password@localhost:3306/cnc_web_manage"

# JWT 签名密钥 (生产环境必须修改！建议 32+ 字符随机字符串)
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"

# 应用端口
PORT=3000

# 运行环境 (development / production)
NODE_ENV=production
