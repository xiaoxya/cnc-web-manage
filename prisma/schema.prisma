generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model RepairVendor {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("repair_vendors")
}

model Spec {
  id         Int      @id @default(autoincrement())
  name       String
  categoryId Int?
  category   ToolCategory? @relation(fields: [categoryId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tools Tool[]

  @@index([categoryId])
  @@map("specs")
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String
  role         String    @default("OPERATOR")
  displayName  String
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  transactions       ToolTransaction[]
  maintenanceReports MaintenanceRecord[]  @relation("Reporter")
  stocktakings       Stocktaking[]

  @@map("users")
}

model ToolCategory {
  id          Int      @id @default(autoincrement())
  code        String
  name        String
  description String?
  counter     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tools Tool[]
  specs Spec[]

  @@index([code])
  @@map("tool_categories")
}

model ToolCodeSequence {
  id        Int      @id
  nextValue Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tool_code_sequences")
}

model Location {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tools Tool[]

  @@map("locations")
}

model Tool {
  id             Int      @id @default(autoincrement())
  toolCode       String   @unique
  name           String
  specification  String?
  specId         Int?
  material       String?
  brand          String?
  categoryId     Int
  locationId     Int?
  quantity       Int      @default(0)
  minQuantity    Int      @default(1)
  maintenanceCount Int    @default(0)
  unit           String   @default("把")
  price          String?
  status         String   @default("IN_STOCK")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category       ToolCategory       @relation(fields: [categoryId], references: [id])
  spec           Spec?              @relation(fields: [specId], references: [id])
  location       Location?          @relation(fields: [locationId], references: [id])
  transactions   ToolTransaction[]
  maintenance    MaintenanceRecord[]
  stocktakingItems StocktakingItem[]

  @@index([categoryId])
  @@index([locationId])
  @@index([specId])
  @@index([status])
  @@index([toolCode])
  @@map("tools")
}

model ToolTransaction {
  id          Int      @id @default(autoincrement())
  toolId      Int
  type        String
  quantity    Int
  factoryId   Int?
  operatorId  Int
  referenceNo String?
  notes       String?
  createdAt   DateTime @default(now())

  tool     Tool @relation(fields: [toolId], references: [id])
  factory  Factory? @relation(fields: [factoryId], references: [id])
  operator User @relation(fields: [operatorId], references: [id])

  @@index([toolId])
  @@index([createdAt])
  @@index([factoryId])
  @@map("tool_transactions")
}

model MaintenanceRecord {
  id           Int      @id @default(autoincrement())
  toolId       Int
  status       String   @default("IN_MAINTENANCE")
  description  String
  cost         String?
  repairVendor String?
  reporterId   Int
  completedAt  DateTime?
  previousStatus String?
  previousFactoryInfo String?
  notes        String?
  createdAt    DateTime @default(now())

  tool     Tool @relation(fields: [toolId], references: [id])
  reporter User @relation("Reporter", fields: [reporterId], references: [id])

  @@index([toolId])
  @@index([status])
  @@map("maintenance_records")
}

model Factory {
  id          Int      @id @default(autoincrement())
  name        String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions ToolTransaction[]
  stocktakings Stocktaking[]

  @@map("factories")
}

model Stocktaking {
  id            Int      @id @default(autoincrement())
  stocktakingNo String   @unique
  factoryId     Int?
  status        String   @default("IN_PROGRESS")
  operatorId    Int
  completedAt   DateTime?
  notes         String?
  createdAt     DateTime @default(now())

  factory  Factory?             @relation(fields: [factoryId], references: [id])
  operator User              @relation(fields: [operatorId], references: [id])
  items    StocktakingItem[]

  @@index([status])
  @@map("stocktakings")
}

model StocktakingItem {
  id               Int    @id @default(autoincrement())
  stocktakingId    Int
  toolId           Int
  expectedQuantity Int
  actualQuantity   Int
  difference       Int
  notes            String?

  stocktaking Stocktaking @relation(fields: [stocktakingId], references: [id])
  tool        Tool        @relation(fields: [toolId], references: [id])

  @@unique([stocktakingId, toolId])
  @@map("stocktaking_items")
}
